<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scriptplatform.mapper.AuditLogMapper">

    <resultMap id="BaseResultMap" type="com.scriptplatform.entity.AuditLog">
        <id column="id" property="id"/>
        <result column="event_time" property="eventTime"/>
        <result column="event_type" property="eventType"/>
        <result column="operator" property="operator"/>
        <result column="operator_ip" property="operatorIp"/>
        <result column="target_id" property="targetId"/>
        <result column="target_name" property="targetName"/>
        <result column="request_params" property="requestParams"/>
        <result column="response_result" property="responseResult"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, event_time, event_type, operator, operator_ip,
        target_id, target_name, request_params, response_result, status, remark
    </sql>

    <sql id="Query_Where">
        <where>
            <if test="startTime != null and startTime != ''">
                and event_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                and event_time &lt;= #{endTime}
            </if>
            <if test="eventTypes != null and eventTypes.size() > 0">
                and event_type in
                <foreach collection="eventTypes" item="t" open="(" close=")" separator=",">
                    #{t}
                </foreach>
            </if>
            <if test="operator != null and operator != ''">
                and operator = #{operator}
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
    </sql>

    <insert id="insert" parameterType="com.scriptplatform.entity.AuditLog" useGeneratedKeys="true" keyProperty="id">
        insert into audit_log (
            event_time, event_type, operator, operator_ip,
            target_id, target_name, request_params, response_result, status, remark
        ) values (
            #{eventTime}, #{eventType}, #{operator}, #{operatorIp},
            #{targetId}, #{targetName}, #{requestParams}, #{responseResult}, #{status}, #{remark}
        )
    </insert>

    <select id="selectPage" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/> from audit_log
        <include refid="Query_Where"/>
        order by id desc
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/> from audit_log
        <include refid="Query_Where"/>
        order by id desc
        limit 10000
    </select>

</mapper>
